{
  "$description": "Visual-led — large imagery, generous whitespace, full-bleed",
  "light": {
    "color": {
      "bg": {
        "surface": { "$value": "{color.gray.50}" },
        "card": { "$value": "{color.white}" },
        "muted": { "$value": "{color.gray.100}" }
      },
      "text": {
        "primary": { "$value": "{color.ink.600}" },
        "secondary": { "$value": "{color.gray.500}" }
      },
      "border": {
        "default": { "$value": "{color.gray.200}" }
      },
      "action": {
        "primary": { "$value": "{color.blue.600}" }
      },
      "status": {
        "live": { "$value": "{color.red.500}" }
      },
      "masthead": {
        "bg": { "$value": "{color.ink.600}" },
        "fg": { "$value": "{color.white}" }
      }
    }
  },
  "dark": {},
  "space": {
    "gap": { "$value": "{space.5}" },
    "section": { "$value": "{space.12}" },
    "pad": { "$value": "{space.6}" },
    "pad-lg": { "$value": "{space.8}" }
  },
  "radius": {
    "default": { "$value": "{radius.2xl}" },
    "card": { "$value": "{radius.3xl}" },
    "button": { "$value": "{radius.xl}" }
  },
  "font": {
    "family": {
      "heading": { "$value": "'Geist', system-ui, sans-serif" }
    },
    "weight": {
      "heading": { "$value": "{font.weight.bold}" }
    },
    "letterSpacing": {
      "heading": { "$value": "{font.letterSpacing.tight}" }
    }
  },
  "density": {
    "mode": { "$value": "roomy" }
  }
}
