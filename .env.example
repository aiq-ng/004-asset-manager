DATABASE_URL="postgresql://postgres:postgres@localhost:5432/assets_inventory?schema=public"
APP_URL="http://localhost:3000"

POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="assets_inventory"

MINIO_ENDPOINT="http://localhost:9000"
MINIO_PUBLIC_ENDPOINT=""
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="asset-images"
MINIO_PRESIGN_EXPIRY_SECONDS="3600"
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
SESSION_SECRET="run: openssl rand -base64 32 and paste the output here"


# Audit trail queue (BullMQ). The API publishes events here and a worker
# process persists them to PostgreSQL. Run it with: pnpm worker:audit
# Redis must run with appendonly persistence and maxmemory-policy noeviction;
# docker-compose.yml already configures it that way.
REDIS_URL="redis://localhost:6379"
AUDIT_REDIS_PREFIX=""

# Transactional email (Resend) — invites and password resets.
# Without a key the mailer logs what it would have sent instead of failing.
# Get a key at https://resend.com; EMAIL_FROM must be a verified sender domain
# (onboarding@resend.dev works only for sending to your own account's email).
RESEND_API_KEY=""
EMAIL_FROM="Inventory Control <onboarding@resend.dev>"
