// Data model for the assets inventory system.
//
// Postgres-specific notes:
// - `AssetStatus` is a native Postgres enum (see migrations).
// - `Assignment` has a PARTIAL UNIQUE INDEX created via raw SQL in the migration:
//     CREATE UNIQUE INDEX "Assignment_one_active_per_asset"
//       ON "Assignment" ("assetId") WHERE "dateReturned" IS NULL;
//   Prisma cannot express partial indexes, so it lives in
//   prisma/migrations/<ts>_init/migration.sql. It is the hard guarantee that an
//   asset can never have two active assignments, even under concurrent writes.
//   Do not drop it: the service layer also checks, but only the index is atomic.
// - All text search uses `mode: "insensitive"` (see lib/services).
// - `Asset.serialNumber` is stored trimmed, and "" is normalised to NULL so
//   several serial-less bulk items do not collide on the unique constraint.
// - `Staff.role` drives the permission matrix in src/lib/auth/permissions.ts.
//   There is exactly one SUPERADMIN, and nothing in the app can hand the role
//   out: it is created once, by the `/setup` screen or
//   `pnpm auth:create-superadmin`, both of which run without a session and
//   neither of which will run twice. A partial unique index
//   (`Staff_one_superadmin`) enforces the "at most one" part in the database,
//   because the checks above it are a read followed by a write and cannot be
//   atomic with each other. Prisma has no schema syntax for a partial index, so
//   it lives in a migration and is unmanaged: decline any diff that proposes
//   dropping it.
// - `Staff.passwordHash` is NULL until a password is set, which locks the
//   account out of login (seeded staff are created without credentials).
// - `Staff.sessionVersion` makes stateless session cookies revocable: it is
//   embedded in the cookie and checked on every request, so signing out or
//   resetting a password invalidates tokens that were already handed out.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  UNDER_REPAIR
  RETIRED
}

// USER < ASSIGNER < ADMIN < SUPERADMIN, each role inheriting the one below.
// See src/lib/auth/permissions.ts for the enforced matrix.
enum StaffRole {
  USER
  ASSIGNER
  ADMIN
  SUPERADMIN
}

model AssetType {
  id   String @id @default(cuid())
  name String @unique
  code String @unique

  assets  Asset[]
  counter Counter?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Asset {
  id           String       @id @default(cuid())
  assetId      String       @unique
  assetTypeId  String
  description  String
  brand        String?
  /** Model number or short name, e.g. `Latitude 5440`. NULL when it has none. */
  model        String?
  serialNumber String?      @unique
  imageKey     String?
  status       AssetStatus  @default(AVAILABLE)

  assetType   AssetType    @relation(fields: [assetTypeId], references: [id])
  assignments Assignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
  @@index([serialNumber])
  @@index([status])
  @@index([brand])
}

model Department {
  id   String @id @default(cuid())
  name String @unique

  staff Staff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Department")
}

model Staff {
  id   String @id @default(cuid())
  name String
  // Reference, not a string: departments are maintained in one place
  // (/departments) and every staff form picks from that list rather than
  // typing a value, so "IT" and "it " cannot both end up in the register.
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  email        String     @unique
  phone        String?
  role         StaffRole  @default(USER)
  // NULL means "no password yet": the account cannot log in.
  passwordHash  String?
  // Set when the account was invited by email and received a temporary password.
  invitedAt     DateTime?
  // True while the account is signed in with a temporary password handed out by
  // an invite: every page and API route except password change/sign-out/metadata
  // refuses to run until they set their own.
  mustChangePassword Boolean @default(false)
  // Bumped on sign-out and password changes to revoke outstanding cookies.
  sessionVersion Int      @default(0)

  assignments Assignment[]
  // Assets this staff member handed out (via the "Assigned by" column).
  assignedAssignments Assignment[] @relation("AssignmentAssignedBy")
  // Returns this staff member accepted (via the "Return accepted by" record).
  returnedAssignments Assignment[] @relation("AssignmentReturnedBy")
  resetTokens PasswordResetToken[]
  auditLogs   AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([departmentId])
}

model Assignment {
  id           String    @id @default(cuid())
  assetId      String
  staffId      String
  dateAssigned DateTime  @default(now())
  dateReturned DateTime?
  note         String?
  // Who handed the asset over — always set by the service from the
  // authenticated actor, never from client input. Nullable so rows written
  // before this field existed stay valid.
  assignedById String?
  assignedBy   Staff?    @relation("AssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  // Return record. `returnNote` describes the condition at handover and
  // `returnImageKey` points at the photo of the asset as it came back (same
  // bucket layout as asset photos, `assignments/{id}/{uuid}.{ext}`).
  // `returnedBy` is the privileged actor who accepted the return — again from
  // the session, never from client input. All nullable: legacy rows and returns
  // recorded before these fields existed stay valid.
  returnNote     String?
  returnImageKey String?
  returnedById   String?
  returnedBy     Staff?    @relation("AssignmentReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([assetId])
  @@index([staffId])
  @@index([staffId, dateReturned])
  @@index([assignedById])
  @@index([returnedById])
}

/// Single-use, short-lived tokens behind the "forgot password" flow. Only the
/// SHA-256 digest of the token is stored, so a database leak cannot be replayed
/// against the reset endpoint. Rows are deleted when consumed; expired ones are
/// swept opportunistically on each new request.
model PasswordResetToken {
  id        String    @id @default(cuid())
  staffId   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([staffId])
}

model Counter {
  id          String    @id @default(cuid())
  assetTypeId String    @unique
  lastNumber  Int       @default(0)
  assetType   AssetType @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
}
/// Append-only trail of who changed what. Rows are written by the BullMQ
/// audit worker (`pnpm worker:audit`), never by request handlers, and the table
/// is protected against UPDATE/DELETE by a database trigger.
///
/// `eventId` is generated by the producer and doubles as the BullMQ job id, so a
/// worker that crashes mid-write and retries cannot store the same event twice.
/// Actor fields are snapshots on purpose: an audit row has to stay readable even
/// after the person it refers to is renamed or deleted (`onDelete: SetNull`).
model AuditLog {
  id         String @id @default(cuid())
  eventId    String @unique

  action     String
  entityType String
  entityId   String?
  summary    String

  // Field-level before/after values. Never stores secrets: passwords and
  // session tokens are redacted before they reach the queue.
  changes  Json?
  metadata Json?

  actorId    String?
  actorName  String?
  actorEmail String?
  actorRole  String?

  ipAddress String?
  userAgent String?
  route     String?

  // When the action happened, as opposed to when the worker persisted it.
  occurredAt DateTime
  createdAt  DateTime @default(now())

  actor Staff? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([occurredAt(sort: Desc)])
  @@index([action])
  @@index([entityType, entityId])
  @@index([actorId, occurredAt(sort: Desc)])
}
